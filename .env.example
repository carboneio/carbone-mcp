# Carbone API key — required for cloud API. Get yours at https://account.carbone.io
# CARBONE_API_KEY=your_api_key_here

# Carbone API base URL — override for self-hosted/on-premise instances (no API key required)
# CARBONE_BASE_URL=https://api.carbone.io

# Request timeout in milliseconds (default: 60000)
# CARBONE_TIMEOUT=60000

# Transport mode: "http" for Docker/self-hosted, "stdio" for AI desktop clients
# MCP_TRANSPORT=http

# HTTP server port (default: 3000)
# MCP_PORT=3000

# HTTP endpoint path (default: /)
# MCP_PATH=/

# Maximum request body size in bytes (default: 62914560 = 60 MB)
# MCP_MAX_BODY_BYTES=62914560

# Maximum size (bytes) of a single input file resolved from a path, URL, or base64 string before it is sent to Carbone. Local OOM/abuse guard (default: 104857600 = 100 MB).
# CARBONE_MAX_FILE_BYTES=104857600

# HTTP only. When "true", a request without an Authorization: Bearer key is rejected instead of
# falling back to the server-level CARBONE_API_KEY. Use for multi-tenant deployments where each
# client must supply its own key. Accepts "true" or "false" (default: false).
# CARBONE_REQUIRE_CLIENT_AUTH_HEADER=false
