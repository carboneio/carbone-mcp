# Carbone API key. Get yours at https://account.carbone.io
# - stdio: required for the Carbone Cloud API (not needed when CARBONE_BASE_URL points to an on-premise server).
# - HTTP: optional. Leave it unset so each client sends its own key as "Authorization: Bearer <key>".
#   When set, requests without a Bearer key spend this key (shared-key server): see CARBONE_REQUIRE_CLIENT_AUTH_HEADER.
# CARBONE_API_KEY=your_api_key_here

# Carbone API base URL — override for self-hosted/on-premise instances (no API key required)
# CARBONE_BASE_URL=https://api.carbone.io

# Request timeout in milliseconds (default: 60000)
# CARBONE_TIMEOUT=60000

# Transport mode: "stdio" (default, for local AI clients) or "http" (self-hosted server; the Docker image default)
# MCP_TRANSPORT=http

# HTTP server port (default: 3000)
# MCP_PORT=3000

# HTTP endpoint path (default: /). Cannot be /health (reserved for the health check).
# MCP_PATH=/

# Maximum size in bytes of one incoming MCP message: HTTP request body (413 when exceeded) or stdio message (default: 62914560 = 60 MB)
# MCP_MAX_BODY_BYTES=62914560

# HTTP only. Browser Origin hostnames allowed in addition to the default localhost, 127.0.0.1 and [::1];
# a request with any other Origin header gets 403 (requests without an Origin header are unaffected).
# Comma-separated hostnames without scheme or port; "<scheme>://*" allows a browser-extension scheme.
# Invalid entries stop the server at startup.
# MCP_ALLOWED_ORIGINS=app.example.com,tools.example.com

# Maximum size (bytes) of a single input file resolved from a path, URL, or base64 string before it is sent to Carbone. Local OOM/abuse guard (default: 104857600 = 100 MB).
# CARBONE_MAX_FILE_BYTES=104857600

# HTTP only. "true" rejects a request without an Authorization: Bearer key instead of falling back to the
# server-level CARBONE_API_KEY. Left "false" (default) with CARBONE_API_KEY set, unauthenticated requests
# spend that key (shared-key server): anyone who can reach the port can use it. No effect without a server key.
# CARBONE_REQUIRE_CLIENT_AUTH_HEADER=false

# Allow user-supplied URLs to resolve to private/internal addresses (default: false).
# Off by default to block SSRF; enable only on a trusted deployment with internal template hosts.
# CARBONE_ALLOW_PRIVATE_NETWORK=false
