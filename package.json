{
  "name": "carbone-mcp",
  "version": "1.0.0",
  "description": "Official MCP for Carbone — Document Generation, Document Conversion, and Universal Templating. Generate PDF, DOCX, XLSX, PPTX, ODT, ODS, CSV, HTML and XML documents from templates and JSON data. Convert Office documents (DOCX, XLSX, PPTX) and HTML to PDF. Automate document workflows with a No-Code / Low-Code approach using your existing data sources and APIs.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "carbone-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp", "claude", "anthropic", "chatgpt",
    "document-generation", "template-engine", "invoice-generation",
    "docx-to-pdf", "html-to-pdf", "office-to-pdf",
    "pdf-forms", "batch-generation", "json-to-pdf", "md-to-pdf"
  ],
  "author": "carboneio",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carboneio/carbone-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/carboneio/carbone-mcp/issues"
  },
  "homepage": "https://carbone.io",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
