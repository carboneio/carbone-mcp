{
  "name": "carbone-mcp",
  "version": "2.0.0",
  "description": "Official Carbone MCP server: generate PDF, DOCX, XLSX and PPTX from templates and JSON, and convert Office, HTML and Markdown files, from Claude, Cursor or any MCP client.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "carbone-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "battle": "node scripts/battle-test.mjs",
    "battle:http": "MCP_TARGET=http node scripts/battle-test.mjs",
    "battle:prod": "MCP_TARGET=prod node scripts/battle-test.mjs"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "carbone",
    "carbone-ice",
    "claude",
    "anthropic",
    "cursor",
    "vscode",
    "document-generation",
    "pdf-generation",
    "report-generation",
    "template-engine",
    "invoice-generation",
    "docx-to-pdf",
    "html-to-pdf",
    "office-to-pdf",
    "pdf-forms",
    "batch-generation",
    "json-to-pdf",
    "md-to-pdf"
  ],
  "author": "carboneio",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carboneio/carbone-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/carboneio/carbone-mcp/issues"
  },
  "homepage": "https://carbone.io/documentation/developer/ai/mcp.html",
  "mcpName": "io.carbone/carbone-mcp",
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "4.23.9",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
