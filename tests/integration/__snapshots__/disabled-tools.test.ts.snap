  "list_templates listing": "{"name":"list_templates","title":"List Templates","description":"List stored templates, with filters and pagination. Each result has an id (Template ID; null for a template uploaded with versioning: false) and a versionId: pass either as templateId to render_document or download_template. Each result lists its tags: to find templates by tag, keep the results whose tags include it.","inputSchema":{"type":"object","properties":{"id":{"description":"Filter by Template ID (64-bit format, digits only). Cannot be a Version ID.","type":"string","pattern":"^\\\\d+$"},"versionId":{"description":"Filter by Version ID (SHA-256 format).","type":"string"},"category":{"description":"Filter by category (e.g. \\"invoices\\", \\"legal\\").","type":"string"},"origin":{"description":"Upload origin: 0 API (this server), 1 Carbone Studio, 2 Salesforce, 3 Odoo, 4 HubSpot.","type":"integer"},"includeVersions":{"description":"If true, returns all versions for each template. Default: false (only deployed version).","type":"boolean"},"search":{"description":"Fuzzy search in template names, or exact match on Template ID / Version ID.","type":"string"},"limit":{"description":"1 to 100 results (default 100); use cursor for more.","type":"integer","minimum":1,"maximum":100},"cursor":{"description":"The nextCursor of the previous response.","type":"string"}},"$schema":"https://json-schema.org/draft/2020-12/schema"},"outputSchema":{"type":"object","properties":{"templates":{"type":"array","items":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"description":"The matching templates (all fields)."},"hasMore":{"type":"boolean","description":"Whether more results are available via the cursor."},"nextCursor":{"description":"Cursor to pass to the next list_templates call.","type":"string"}},"required":["templates","hasMore"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"title":"List Templates","readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}}",
  "render_document listing": "{"name":"render_document","title":"Generate Document","description":"Generate a document (PDF, DOCX, XLSX, PPTX, ...) by merging JSON data into a Carbone template. Pass templateId for a stored template, or template (local path, HTTPS URL or base64) for a one-off render. To change the format of a file without data, use convert_document; unsure which data a template expects, call inspect_template first. Returns text and images (png, jpg, gif, webp) inline; other formats are saved to a temp file whose path is returned. Batches need a webhookUrl the user provides; otherwise render one document per call.","inputSchema":{"type":"object","properties":{"templateId":{"description":"A stored template, from list_templates (never guess one): its Template ID (digits, renders the deployed version) or a Version ID (64 hex characters, pins that version). Exclusive with template.","type":"string","minLength":1},"template":{"description":"A one-off template, not stored. An absolute local path (\\"/Users/me/report.docx\\", \\"~/report.docx\\"; a bare name like \\"report.docx\\" is read as base64), an HTTPS URL, or the file as base64. Formats: DOCX, XLSX, PPTX, ODT, ODS, ODP, ODG, HTML, XHTML, XML, SVG, IDML, MD, TXT, CSV, RTF, PDF; not the legacy binary DOC, XLS or PPT (re-save them as DOCX, XLSX, PPTX). Exclusive with templateId.","type":"string","minLength":1},"data":{"description":"JSON for the {d.…} tags: an object, a top-level array, or a reference to a JSON file (local path, HTTPS URL or base64). Omitted: every tag renders empty; to keep tags as written, use keepTags. Tag syntax: the Carbone Skill.","anyOf":[{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},{"type":"array","items":{}},{"type":"string"}]},"convertTo":{"description":"Output format, e.g. \\"pdf\\". Omitted: the template's own format. Valid outputs depend on the input format (HTML converts to pdf or png, not xlsx; doc, xls and ppt are output only). With options: { \\"formatName\\": \\"pdf\\", \\"formatOptions\\": { ... } }.","anyOf":[{"type":"string","enum":["pdf","docx","doc","odt","ott","rtf","epub","xlsx","xls","ods","ots","csv","dbf","dif","pptx","ppt","odp","otp","odg","html","xhtml","txt","md","xml","idml","png","jpg","jpeg","webp","gif","tiff","bmp","svg","emf","wmf","eps"]},{"type":"object","properties":{"formatName":{"type":"string","description":"Same values as the string form."},"formatOptions":{"description":"PDF: { \\"EncryptFile\\": true, \\"DocumentOpenPassword\\": \\"s3cr3t\\" }, { \\"Watermarks\\": [{ \\"text\\": \\"DRAFT\\", \\"opacity\\": 0.2 }] }, PDF/A { \\"SelectPdfVersion\\": 2 } or { \\"PageRange\\": \\"1-5\\" } (converter \\"L\\"). Images: { \\"PixelWidth\\": 1200, \\"Scale\\": 2, \\"Quality\\": 80 }. CSV: { \\"fieldSeparator\\": \\";\\" }. All options: get_capabilities.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["formatName"]}]},"converter":{"description":"Converter, used whenever the format changes. \\"L\\" LibreOffice (default): every format, and the only one with PDF/A, page ranges and accessibility. \\"I\\" Carbone ICE: DOCX and ODT to PDF, the fastest (keep \\"L\\" for WEBP or EMF/WMF images, SmartArt, complex charts, comments, form fields, equations, bookmarks, endnotes, and ODT tracked changes or footnotes). \\"O\\" OnlyOffice: DOCX, XLSX, PPTX to PDF. \\"C\\" Chromium: HTML and SVG to PDF, PNG, JPG, WEBP. Details: get_capabilities.","type":"string","enum":["L","O","C","I"]},"timezone":{"description":"IANA time zone for :formatD dates, e.g. \\"America/New_York\\". Default \\"Europe/Paris\\".","type":"string"},"lang":{"description":"Locale for {t()} translations, :formatN and :formatC, e.g. \\"fr-fr\\", \\"en-us\\".","type":"string"},"complement":{"description":"Extra data for {c.…} tags (company details, constants), or a reference to a JSON file.","anyOf":[{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},{"type":"string"}]},"variableStr":{"description":"Aliases for the whole template, e.g. \\"{#buyer = d.order.customer}\\", then {$buyer.name} in it.","type":"string"},"reportName":{"description":"File name without extension; may use tags, e.g. \\"invoice-{d.id}\\" (taken literally with keepTags).","type":"string"},"enum":{"description":"Labels for :convEnum(TYPE), e.g. { \\"STATUS\\": { \\"1\\": \\"Active\\" } }, or a reference to a JSON file.","anyOf":[{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},{"type":"string"}]},"translations":{"description":"Strings for {t(key)}, selected by lang: { \\"fr-fr\\": { \\"hello\\": \\"Bonjour\\" } }, or a reference to a JSON file.","anyOf":[{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}}},{"type":"string"}]},"currencySource":{"description":"ISO 4217 currency of the amounts in data, for :formatC. Set with currencyTarget and currencyRates.","type":"string"},"currencyTarget":{"description":"ISO 4217 currency to convert the amounts to.","type":"string"},"currencyRates":{"description":"Rates per currency, base 1: { \\"EUR\\": 1, \\"USD\\": 1.08 }, or a reference to a JSON file.","anyOf":[{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"number"}},{"type":"string"}]},"keepTags":{"description":"If true, skip templating: tags stay as written, to proof a template's layout. Exclusive with data.","type":"boolean"},"hardRefresh":{"description":"If true, recompute pagination and the table of contents after rendering. Needs convertTo.","type":"boolean"},"batchSplitBy":{"description":"One document per item of an array: \\"d\\" when data is the array, \\"d.items\\" for a child array; at most 100. Needs a webhookUrl the user provides.","type":"string"},"batchOutput":{"description":"Batch result: \\"zip\\" (default, named after reportName, or batch.zip without one) or \\"pdf\\", one concatenated PDF (needs convertTo \\"pdf\\").","type":"string","enum":["zip","pdf"]},"batchReportName":{"description":"Name of each file in the batch ZIP, without extension; tags resolve per item, e.g. \\"invoice-{d.id}\\".","type":"string"},"preReleaseFeatureIn":{"description":"Turn on Carbone pre-release features up to this version tag, e.g. 5000000.","type":"integer"},"failOn":{"description":"[\\"IMAGE_URL_ERROR\\"]: fail when an image URL cannot be downloaded, instead of showing a placeholder.","type":"array","items":{"type":"string","enum":["IMAGE_URL_ERROR"]}},"webhookUrl":{"description":"Only an endpoint the user owns and gives you: Carbone POSTs { \\"success\\": true, \\"data\\": { \\"renderId\\" } } to it when the document is ready, and that server downloads it once. This call then returns no document.","type":"string","format":"uri"},"webhookHeaders":{"description":"Headers Carbone sends to webhookUrl, e.g. { \\"authorization\\": \\"secret\\" }.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}},"egressAuthorization":{"description":"Authorization header value Carbone sends when it fetches images, PDFs or the webhook while rendering.","type":"string","maxLength":511},"outputPath":{"description":"Local path to save the generated document to, e.g. \\"~/out.pdf\\"; returns the path and size. Never overwrites a file.","type":"string"},"asAttachment":{"description":"If true, return the file itself as a base64 attachment, for any format, instead of the default (temp file or inline).","type":"boolean"},"returnLink":{"description":"If true, return a one-time download link instead of the file, for the user to open (never fetch it yourself). Exclusive with outputPath and asAttachment.","type":"boolean"}},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"title":"Generate Document","readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true}}",
}
